POSTGRES_USER=autoservice
POSTGRES_PASSWORD=autoservice
POSTGRES_DB=autoservice
DATABASE_URL=postgres://autoservice:autoservice@db:5432/autoservice?sslmode=disable

API_PORT=8080
WEB_PORT=3000

# openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me-0000
JWT_TTL=24h

# LLM, которая по первому сообщению клиента определяет услугу и заполняет форму.
# Подходит любой OpenAI-совместимый API: OpenAI, OpenRouter, локальный сервер (Ollama, vLLM).
# Если LLM_MODEL пустой, бот работает без LLM: клиент выбирает услугу кнопкой.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Публичный https-адрес кабинета. Если задан, в уведомлении мастеру будет кнопка «Открыть в CRM».
APP_URL=

# Необязательно: включает internal API (/internal/v1) для внешних интеграций, ключ передаётся в X-API-Key.
# Встроенному боту не нужен. openssl rand -hex 24
BOT_API_KEY=

TELEGRAM_API_URL=https://api.telegram.org
LOG_LEVEL=info

# true behind HTTPS
COOKIE_SECURE=false
