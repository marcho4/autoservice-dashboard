POSTGRES_USER=autoservice
POSTGRES_PASSWORD=autoservice
POSTGRES_DB=autoservice
DATABASE_URL=postgres://autoservice:autoservice@db:5432/autoservice?sslmode=disable

API_PORT=8080
WEB_PORT=3000

# openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me-0000
JWT_TTL=24h

# Shared secret of the Telegram bot-runner, sent in the X-API-Key header.
# openssl rand -hex 24
BOT_API_KEY=change-me-bot-runner-api-key

TELEGRAM_API_URL=https://api.telegram.org
LOG_LEVEL=info

# true behind HTTPS
COOKIE_SECURE=false
